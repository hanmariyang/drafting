{
  "name": "@hanmariyang/drafting",
  "version": "1.6.8",
  "description": "AI Planning Workspace — self-hosted, BYOK. Draft PRDs & feature specs via staged AI interviews. Run: npx @hanmariyang/drafting serve",
  "license": "MIT",
  "homepage": "https://github.com/hanmariyang/drafting",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanmariyang/drafting.git"
  },
  "keywords": [
    "prd",
    "planning",
    "ai",
    "product",
    "self-hosted",
    "byok"
  ],
  "bin": {
    "drafting": "bin/drafting.mjs"
  },
  "files": [
    "bin/",
    "api/dist/",
    "api/templates/",
    "db/schema.sql",
    "web/dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web && npm run build --workspace api",
    "start": "node api/dist/index.js",
    "test": "npm run test --workspace api",
    "prepublishOnly": "npm run build",
    "mcp": "node --experimental-strip-types api/src/mcp.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "marked": "^15.0.4",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
