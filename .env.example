# ─── PlanForge configuration ─────────────────────────────────────────────
# Copy to `.env` and adjust. All AI keys are BYOK — entered in the app's setup
# wizard, NOT here. This file only holds server-side infra config.

# Host port the app is served on (docker-compose maps this → container 8080).
PLANFORGE_PORT=8477

# Master key used to encrypt BYOK provider keys at rest (AES-256-GCM).
# MUST be a 32-byte value, base64 or hex. If unset, the server generates one on
# first boot and persists it to the data dir (data/master.key, chmod 600).
# Set this explicitly in production so keys survive a data-dir wipe.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# SQLite database file (inside the container / data dir).
DATABASE_PATH=/data/planforge.sqlite

# ─── Managed tier (v2, P-03) ─────────────────────────────────────────────
# v1 ships BYOK only. When a managed tier exists, flip this to route AI calls
# through ManagedProvider instead of the user's own keys. Interface only in v1.
MANAGED_TIER=false
# MANAGED_API_BASE=
# MANAGED_API_KEY=

# ─── Development / testing ───────────────────────────────────────────────
# Force the deterministic stub AI provider (no network, no real key needed).
# Used by the test suite and by `docker compose` demos. Set to 1 to enable.
AI_STUB=
